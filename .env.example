# PaperFolio – configurazione. Copia questo file in .env e adatta i valori.
# Il file .env non va mai nel repository.

# Porta dell'app (sul Pi è la porta esposta dal container)
PORT=8042

# Solo Docker (Pi): cartella dati FUORI dal repository, con database e backup.
# Un percorso relativo è riferito alla cartella del repository.
PAPERFOLIO_DATA_DIR=../paperfolio-data

# Solo sviluppo (PC): database separato da quello del Pi.
# Se assente si usa backend/data/paperfolio.db (escluso da git).
# DATABASE_URL=sqlite:///./backend/data/paperfolio-dev.db

# Capitale del primo portafoglio (EUR); poi si cambia dalle Impostazioni con il reset
INITIAL_CAPITAL=10000.00

# Fuso orario di visualizzazione
DISPLAY_TZ=Europe/Rome

# Origini consentite per CORS (non serve se si usa l'app servita dal backend)
CORS_ORIGINS=*
